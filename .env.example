# 웹 배포 주소. Vercel 배포 후 실제 Production URL로 바꾸세요.
NEXT_PUBLIC_SITE_URL=https://today-scammer.vercel.app

# AdSense 승인 전에는 비워두면 광고 영역과 외부 광고 스크립트가 모두 숨겨집니다.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_HOME_SLOT=
NEXT_PUBLIC_ADSENSE_RESULT_SLOT=

# AdSense 승인 후 Offerwall의 URL 포함 규칙을 /unlock/ 로 설정하고 true로 바꿉니다.
NEXT_PUBLIC_REWARDED_UNLOCKS_ENABLED=false

# Apps in Toss 전용 빌드. 값이 없으면 현재 운영 기본값을 사용합니다.
VITE_TOSS_REWARDED_AD_GROUP_ID=ait.v2.live.6141fea128c44f43
VITE_TOSS_BANNER_AD_GROUP_ID=ait.v2.live.72cbbf1ba4fb488b
VITE_TOSS_AD_FREE_PRODUCT_ID=today_scammer_ad_free
